+pub fn write_saves(device: &mut device::Device, force: bool) {
+    #[cfg(target_os = "android")]
+    let _ = (device, force);
+
+    #[cfg(not(target_os = "android"))]
+    {
+        if device.netplay.is_some() {
+            return;
+        }
+
+        let mut retry = false;
+        for (channel, pak) in device.transferpaks.iter_mut().enumerate() {
+            let path = &device.ui.config.input.gb_ram_path[channel];
+            if !device.ui.config.input.transfer_pak[channel]
+                || path.is_empty()
+                || pak.cart.ram.is_empty()
+                || (!force && !pak.cart.write_pending)
+            {
+                continue;
+            }
+
+            match device::controller::gbcart::save(&pak.cart, device.vi.elapsed_time as i64, path) {
+                Ok(()) => pak.cart.write_pending = false,
+                Err(error) => {
+                    eprintln!("Error saving TransferPak RAM to {path}: {error}");
+                    retry = true;
+                }
+            }
+        }
+
+        if retry && !force {
+            ui::storage::schedule_save_event(device);
+        }
+    }
+}
