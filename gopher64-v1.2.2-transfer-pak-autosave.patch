+#[cfg(not(target_os = "android"))]
+pub fn save(cart: &GbCart, elapsed_time: i64, ram_path: &str) -> std::io::Result<()> {
+    use std::path::Path;
+
+    let path = Path::new(ram_path);
+    let parent = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."));
+    let mut file = tempfile::NamedTempFile::new_in(parent)?;
+    file.write_all(&cart.ram)?;
+
+    if cart.cart_type == CartType::MBC3RamBattRtc {
+        let mut rtc_regs = cart.rtc_regs;
+        advance_rtc(&mut rtc_regs, elapsed_time - cart.last_elapsed_time);
+        for value in rtc_regs.into_iter().chain(cart.rtc_regs_latch) {
+            file.write_all(&u32::from(value).to_le_bytes())?;
         }
-    } else {
-        eprintln!("Error saving TransferPak RAM to {ram_path}");
+
+        // Emulated time can run ahead of real time during fast forward.
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_secs() as i64;
+        let timestamp = (cart.rtc_base_time + elapsed_time).min(now);
+        file.write_all(&timestamp.to_le_bytes())?;
     }
+
+    file.as_file().sync_all()?;
+    file.persist(path)?;
+    Ok(())
 }
 
